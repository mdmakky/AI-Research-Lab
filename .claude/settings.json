{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/rlab.py:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "WebSearch",
      "WebFetch(domain:api.openalex.org)",
      "WebFetch(domain:openalex.org)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:export.arxiv.org)",
      "WebFetch(domain:pubmed.ncbi.nlm.nih.gov)",
      "WebFetch(domain:eutils.ncbi.nlm.nih.gov)",
      "WebFetch(domain:europepmc.org)",
      "WebFetch(domain:www.semanticscholar.org)",
      "WebFetch(domain:api.semanticscholar.org)",
      "WebFetch(domain:aclanthology.org)",
      "WebFetch(domain:openreview.net)",
      "WebFetch(domain:dl.acm.org)",
      "WebFetch(domain:ieeexplore.ieee.org)",
      "WebFetch(domain:link.springer.com)",
      "WebFetch(domain:www.sciencedirect.com)",
      "WebFetch(domain:www.nature.com)",
      "WebFetch(domain:scholar.archive.org)"
    ],
    "deny": [
      "WebFetch(domain:sci-hub.se)",
      "WebFetch(domain:sci-hub.st)",
      "WebFetch(domain:sci-hub.ru)",
      "WebFetch(domain:libgen.is)",
      "WebFetch(domain:libgen.rs)",
      "WebFetch(domain:libgen.li)",
      "WebFetch(domain:annas-archive.org)",
      "WebFetch(domain:z-lib.org)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_research.py"
          }
        ]
      }
    ]
  }
}
